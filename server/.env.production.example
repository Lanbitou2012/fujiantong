# ========================================
# 附件通 生产环境变量模板
# 部署到服务器后：cp .env.production.example .env  然后 vi .env 填值
# ========================================

# 服务
SERVER_PORT=8080
SERVER_HOST=127.0.0.1
GIN_MODE=release

# MySQL — 用新库 fujiantong（与已废弃的旧项目 fujiantong_v2 库不冲突）
DB_DSN=fujian_user:strong_password@tcp(127.0.0.1:3306)/fujiantong?charset=utf8mb4&parseTime=True&loc=Local

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# JWT（生产必改）：openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret

# 管理员初始账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password

# 平台域名（注意与旧 fujian.5g6g.top 区分）
PLATFORM_DOMAIN=fujian.5g6g.top
API_BASE_URL=https://fujian.5g6g.top
PUBLIC_BASE_URL=https://fujian.5g6g.top
UPLOAD_DIR=uploads

# ========== 存储驱动 ==========
STORAGE_DRIVER=local
COS_BUCKET_URL=
COS_SECRET_ID=
COS_SECRET_KEY=
CDN_BASE_URL=

# ========== 微信开放平台 - 第三方平台（运营自动化中枢） ==========
WX_COMPONENT_APPID=wx037bc87a7245b35e
WX_COMPONENT_APPSECRET=
WX_COMPONENT_TOKEN=
WX_COMPONENT_ENCODING_AES_KEY=

# ========== 微信开放平台 - 网站应用（扫码登录） ==========
WECHAT_OPEN_APPID=
WECHAT_OPEN_APPSECRET=
WECHAT_OPEN_REDIRECT_URI=https://fujian.5g6g.top/api/v1/auth/wechat/login

# ========== 模板小程序（可选） ==========
WECHAT_MINI_APPID=
WECHAT_MINI_APPSECRET=
