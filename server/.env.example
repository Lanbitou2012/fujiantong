# ========================================
# 附件通 后端环境变量模板
# 复制为 .env 后填入实际值
# ========================================

# 服务端口
SERVER_PORT=8080

# MySQL DSN
DB_DSN=root:password@tcp(127.0.0.1:3306)/fujiantong?charset=utf8mb4&parseTime=True&loc=Local

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# JWT 密钥（生产环境必须修改！）
JWT_SECRET=change-me-in-production

# 管理员初始账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# 微信开放平台 - 第三方平台
WX_COMPONENT_APPID=wx037bc87a7245b35e
WX_COMPONENT_APPSECRET=
WX_COMPONENT_TOKEN=
WX_COMPONENT_ENCODING_AES_KEY=

# 微信开放平台 - 网站应用（扫码登录）
WECHAT_OPEN_APPID=
WECHAT_OPEN_APPSECRET=
WECHAT_OPEN_REDIRECT_URI=

# 微信小程序（模板小程序配置）
WECHAT_MINI_APPID=
WECHAT_MINI_APPSECRET=

# 平台域名
PLATFORM_DOMAIN=fujian.5g6g.top
API_BASE_URL=https://fujian.5g6g.top

# 腾讯云 COS（V2.0 存储阶段）
