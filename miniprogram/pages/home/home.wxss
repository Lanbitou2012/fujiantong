.hero {
  border-radius: 16rpx;
  padding: 60rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.hero-title { font-size: 44rpx; font-weight: 700; }
.hero-sub { margin-top: 12rpx; font-size: 26rpx; opacity: 0.9; line-height: 1.5; }

.guide-card .guide-title {
  font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx;
}
.guide-step {
  display: flex; gap: 20rpx; align-items: flex-start;
  padding: 14rpx 0; border-bottom: 1rpx solid #f0f0f0;
}
.guide-step:last-child { border-bottom: none; }
.step-num {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: var(--primary-color);
  color: #fff; font-size: 24rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.step-text { flex: 1; font-size: 28rpx; color: #555; line-height: 1.6; }

.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.file-row {
  display: flex; gap: 20rpx; align-items: center;
  padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0;
}
.file-row:last-child { border-bottom: none; }
.file-icon {
  width: 80rpx; height: 80rpx; border-radius: 12rpx;
  background: var(--primary-color);
  color: #fff; font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  text-transform: uppercase;
}
.file-info { flex: 1; min-width: 0; }
.file-name { font-size: 28rpx; color: #333; line-height: 1.4; }
.file-meta { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.empty-tip {
  text-align: center; padding: 80rpx 0; color: #999;
}
